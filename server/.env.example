NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=1mb
SESSION_TTL_MINUTES=120
LOG_LEVEL=info

# OpenAI Responses API
# When OPENAI_API_KEY is present, the interview engine uses AI services
# with structured JSON outputs. Without it, a deterministic fallback runs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional override for the prompt files directory (defaults to ../../prompts
# relative to the compiled server module, i.e. the repo root /prompts).
#PROMPTS_DIR=/absolute/path/to/prompts
